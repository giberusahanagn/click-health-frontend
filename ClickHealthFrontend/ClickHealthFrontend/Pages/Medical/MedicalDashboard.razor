@page "/medical/dashboard"
@using System.Net.Http.Json

<h1 class="text-2xl font-bold mb-4">Medical Content Dashboard</h1>

<div class="mb-6 grid grid-cols-3 gap-4 text-center">
    <div class="bg-green-100 text-green-800 p-3 rounded-lg shadow">
        <div class="text-lg font-semibold">Approved</div>
        <div class="text-2xl font-bold">@ApprovedContents.Count</div>
    </div>
    <div class="bg-yellow-100 text-yellow-800 p-3 rounded-lg shadow">
        <div class="text-lg font-semibold">Pending Approval</div>
        <div class="text-2xl font-bold">@PendingContents.Count</div>
    </div>
    <div class="bg-red-100 text-red-800 p-3 rounded-lg shadow">
        <div class="text-lg font-semibold">Rejected</div>
        <div class="text-2xl font-bold">@RejectedContents.Count</div>
    </div>
</div>

@if (PendingContents.Any())
{
    <h2 class="text-xl font-semibold mt-6 mb-2">Pending Contents</h2>
    @Table(PendingContents, showActions: true)
}

@if (ApprovedContents.Any())
{
    <h2 class="text-xl font-semibold mt-6 mb-2">Approved Contents</h2>
    @Table(ApprovedContents)
}

@if (RejectedContents.Any())
{
    <h2 class="text-xl font-semibold mt-6 mb-2">Rejected Contents</h2>
    @Table(RejectedContents)
}

@code {
    [Inject] public HttpClient Http { get; set; } = default!;

    private List<ContentDto> Items { get; set; } = new();

    private List<ContentDto> PendingContents => Items.Where(i => i.Status == "PendingApproval").ToList();
    private List<ContentDto> ApprovedContents => Items.Where(i => i.Status == "Approved").ToList();
    private List<ContentDto> RejectedContents => Items.Where(i => i.Status == "Rejected").ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAllContents();
    }

    private async Task LoadAllContents()
    {
        try
        {
            var approved = await Http.GetFromJsonAsync<List<ContentDto>>("api/content/approved") ?? new();
            var pending = await Http.GetFromJsonAsync<List<ContentDto>>("api/content/pending") ?? new();
            var rejected = await Http.GetFromJsonAsync<List<ContentDto>>("api/content/rejected") ?? new();

            Items = approved.Concat(pending).Concat(rejected).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading content: {ex.Message}");
        }
    }

    private async Task ApproveContent(string contentId)
    {
        await Http.PutAsync($"api/content/update-status/{contentId}?newStatus=Approved", null);
        await LoadAllContents();
    }

    private async Task RejectContent(string contentId)
    {
        await Http.PutAsync($"api/content/update-status/{contentId}?newStatus=Rejected", null);
        await LoadAllContents();
    }

    private RenderFragment Table(List<ContentDto> list, bool showActions = false) => @<table class="min-w-full border rounded-lg overflow-hidden shadow mb-6">
    <thead class="bg-gray-100">
        <tr>
            <th class="px-4 py-2 text-left">Medical Name</th>
            <th class="px-4 py-2 text-left">Language</th>
            <th class="px-4 py-2 text-left">Description</th>
            <th class="px-4 py-2 text-left">View PDF</th>
            <th class="px-4 py-2 text-left">View Video</th>
            <th class="px-4 py-2 text-left">Uploaded By</th>
            <th class="px-4 py-2 text-left">Expiry Date</th>
            @if (showActions)
                        {
            <th class="px-4 py-2 text-left">Actions</th>
                        }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in list)
        {
            <tr class="border-b hover:bg-gray-50">
                <td class="px-4 py-2">@(!string.IsNullOrEmpty(item.Therapy) ? item.Therapy : "N/A")</td>
                <td class="px-4 py-2">@(!string.IsNullOrEmpty(item.ContentLanguage) ? item.ContentLanguage : "N/A")</td>
                <td class="px-4 py-2">@(!string.IsNullOrEmpty(item.Description) ? item.Description : "N/A")</td>
                <td class="px-4 py-2">
                    @if (!string.IsNullOrEmpty(item.ViewPdf))
                    {
                        <a href="@item.ViewPdf" target="_blank" class="text-blue-600 hover:underline">View PDF</a>
                    }
                    else
                    {
                        <span class="text-gray-400">N/A</span>
                    }
                </td>
                <td class="px-4 py-2">
                    @if (!string.IsNullOrEmpty(item.ViewVideo))
                    {
                        <a href="@item.ViewVideo" target="_blank" class="text-blue-600 hover:underline">View Video</a>
                    }
                    else
                    {
                        <span class="text-gray-400">N/A</span>
                    }
                </td>
                <td class="px-4 py-2">@item.UploadedBy</td>
                <td class="px-4 py-2">@item.EndDate?.ToString("yyyy-MM-dd") ?? "N/A"</td>
                @if (showActions)
                {
                    <td class="px-4 py-2 space-x-2">
                        <button class="bg-green-500 text-white px-3 py-1 rounded hover:bg-green-600"
                                @onclick="() => ApproveContent(item.ContentId)">
                            Approve
                        </button>
                        <button class="bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600"
                                @onclick="() => RejectContent(item.ContentId)">
                            Reject
                        </button>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>;

// ✅ Updated ContentDto
public class ContentDto
{
    public string ContentId { get; set; } = "";
    public string Therapy { get; set; } = ""; // Medical Name
    public string ContentLanguage { get; set; } = "";
    public string Description { get; set; } = "";
    public string ViewPdf { get; set; } = "";
    public string ViewVideo { get; set; } = "";
    public string Status { get; set; } = "";
    public string UploadedBy { get; set; } = "";
    public string ApprovedBy { get; set; } = "";
    public DateTime? EndDate { get; set; }
}
}
