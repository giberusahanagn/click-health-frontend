@page "/medical/content-management"
@using ClickHealthFrontend.Layout
@inject HttpClient Http

<h3 class="text-2xl font-semibold mb-4">Medical Content Management</h3>

@if (approvedContents == null)
{
    <p>Loading...</p>
}
else
{
    <h4 class="mt-4 text-lg font-semibold text-green-700">Approved</h4>
    <ContentTable Items="@approvedContents" />

    <h4 class="mt-4 text-lg font-semibold text-yellow-700">Pending Approval</h4>
    <ContentTable Items="@pendingContents" IsPending="true"
                  OnApprove="ApproveContent" OnReject="RejectContent" />

    <h4 class="mt-4 text-lg font-semibold text-red-700">Rejected</h4>
    <ContentTable Items="@rejectedContents" />
}

@code {
    private List<ContentTable.ContentDto>? approvedContents;
    private List<ContentTable.ContentDto>? pendingContents;
    private List<ContentTable.ContentDto>? rejectedContents;

    protected override async Task OnInitializedAsync()
    {
        approvedContents = await Http.GetFromJsonAsync<List<ContentTable.ContentDto>>("api/Content/approved");
        pendingContents = await Http.GetFromJsonAsync<List<ContentTable.ContentDto>>("api/Content/pending");
        rejectedContents = await Http.GetFromJsonAsync<List<ContentTable.ContentDto>>("api/Content/rejected");
    }

    private async Task ApproveContent(string contentId)
    {
        await Http.PutAsync($"api/Content/update-status/{contentId}?newStatus=Approved", null);
        await RefreshData();
    }

    private async Task RejectContent(string contentId)
    {
        await Http.PutAsync($"api/Content/update-status/{contentId}?newStatus=Rejected", null);
        await RefreshData();
    }

    private async Task RefreshData()
    {
        approvedContents = await Http.GetFromJsonAsync<List<ContentTable.ContentDto>>("api/Content/approved");
        pendingContents = await Http.GetFromJsonAsync<List<ContentTable.ContentDto>>("api/Content/pending");
        rejectedContents = await Http.GetFromJsonAsync<List<ContentTable.ContentDto>>("api/Content/rejected");
        StateHasChanged();
    }
}
