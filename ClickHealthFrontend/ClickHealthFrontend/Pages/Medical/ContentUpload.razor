@page "/medical/content-upload"
@inject HttpClient Http
@inject NavigationManager Navigation

<h3 class="text-2xl font-semibold mb-4">Upload Medical Content</h3>

<EditForm Model="@uploadModel" OnValidSubmit="SubmitContent">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
            <label>Medical Name</label>
            <InputText @bind-Value="uploadModel.MedicalName" class="form-control" />
        </div>

        <div>
            <label>Language</label>
            <InputText @bind-Value="uploadModel.ContentLanguage" class="form-control" />
        </div>

        <div class="md:col-span-2">
            <label>Description</label>
            <InputTextArea @bind-Value="uploadModel.ContentDescription" class="form-control" />
        </div>

        <div>
            <label>Start Date</label>
            <InputDate @bind-Value="uploadModel.StartDate" class="form-control" />
        </div>

        <div>
            <label>Expires On</label>
            <InputDate @bind-Value="uploadModel.ExpiresOn" class="form-control" />
        </div>

        <div>
            <label>Upload PDF</label>
            <InputFile OnChange="@(e => OnFileSelected(e, "pdf"))" />
            @if (!string.IsNullOrEmpty(uploadModel.PdfUrl))
            {
                <p class="text-green-600 text-sm">Uploaded: @uploadModel.PdfUrl</p>
            }
        </div>

        <div>
            <label>Upload Video</label>
            <InputFile OnChange="@(e => OnFileSelected(e, "video"))" />
            @if (!string.IsNullOrEmpty(uploadModel.VideoUrl))
            {
                <p class="text-green-600 text-sm">Uploaded: @uploadModel.VideoUrl</p>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-4">Save and Submit Content</button>
</EditForm>

@code {
    private ContentUploadModel uploadModel = new();
    private IBrowserFile? pdfFile;
    private IBrowserFile? videoFile;

    private void OnFileSelected(InputFileChangeEventArgs e, string type)
    {
        if (type == "pdf") pdfFile = e.File;
        if (type == "video") videoFile = e.File;
    }

    private async Task SubmitContent()
    {
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(uploadModel.MedicalName), "MedicalName");
            content.Add(new StringContent(uploadModel.ContentLanguage), "ContentLanguage");
            content.Add(new StringContent(uploadModel.ContentDescription), "ContentDescription");
            content.Add(new StringContent(uploadModel.StartDate?.ToString("o") ?? ""), "StartDate");
            content.Add(new StringContent(uploadModel.ExpiresOn?.ToString("o") ?? ""), "ExpiresOn");

            if (pdfFile != null)
            {
                var pdfStream = pdfFile.OpenReadStream(100_000_000);
                content.Add(new StreamContent(pdfStream), "Pdf", pdfFile.Name);
            }

            if (videoFile != null)
            {
                var videoStream = videoFile.OpenReadStream(500_000_000);
                content.Add(new StreamContent(videoStream), "Video", videoFile.Name);
            }

            // POST request to backend
           
            var request = new HttpRequestMessage(HttpMethod.Post, "api/Content/upload")
            {
                Content = content
            };

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResponse>();
                Console.WriteLine($"Content uploaded: {result?.Message}");
                Navigation.NavigateTo("/medical/dashboard");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error uploading content: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception during upload: {ex.Message}");
        }
    }

    public class UploadResponse
    {
        public string? Message { get; set; }
    }

    public class ContentUploadModel
    {
        public string MedicalName { get; set; } = "";
        public string ContentLanguage { get; set; } = "";
        public string ContentDescription { get; set; } = "";
        public DateTime? StartDate { get; set; }
        public DateTime? ExpiresOn { get; set; }
        public string PdfUrl { get; set; } = "";
        public string VideoUrl { get; set; } = "";
    }
}
