@page "/admin-login"
@inject HttpClient Http
@inject NavigationManager Navigation

<h3 class="text-center mb-3">Admin Login</h3>

<div class="card p-4 shadow-lg rounded mx-auto" style="max-width:400px">
    <input @bind="email" placeholder="Admin Email" class="form-control mb-2" />
    <input @bind="password" type="password" placeholder="Password" class="form-control mb-3" />

    <button class="btn btn-primary w-100 mb-2" @onclick="HandleAdminLogin" disabled="@isLoading">
        @if (isLoading)
        {
            <span>Sending OTP...</span>
        }
        else
        {
            <span>Get OTP</span>
        }
    </button>

    @if (otpSent)
    {
        <div class="mt-3 animate__animated animate__fadeIn">
            <input @bind="otp" placeholder="Enter OTP" class="form-control mb-2" />
            <button class="btn btn-success w-100" @onclick="VerifyOtp">Verify OTP</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <p class="text-info text-center mt-2">@message</p>
    }
</div>

@if (showRegisterPopup)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">
                <h5>Admin Not Registered</h5>
                <p class="text-secondary">Please register first to continue.</p>
                <button class="btn btn-primary w-50" @onclick="GoToRegister">Go to Register</button>
                <button class="btn btn-secondary w-50 mt-2" @onclick="ClosePopup">Cancel</button>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    string email = "";
    string password = "";
    string otp = "";
    bool otpSent = false;
    bool isLoading = false;
    string message = "";
    bool showRegisterPopup = false;

    private async Task HandleAdminLogin()
    {
        try
        {
            isLoading = true;
            message = "";

            var payload = new { Email = email, Password = password };
            var response = await Http.PostAsJsonAsync("api/admin/login", payload);

            if (response.IsSuccessStatusCode)
            {
                otpSent = true;
                message = "✅ OTP sent to your registered email.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                showRegisterPopup = true;
            }
            else
            {
                message = "❌ Invalid admin credentials.";
            }
        }
        catch (Exception ex)
        {
            message = "Error: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task VerifyOtp()
    {
        try
        {
            message = "";
            var payload = new { Email = email, Otp = otp };
            var response = await Http.PostAsJsonAsync("api/admin/verify-otp", payload);

            if (response.IsSuccessStatusCode)
            {
                message = "✅ Admin login successful!";
                Navigation.NavigateTo("/admin-dashboard");
            }
            else
            {
                message = "❌ Invalid OTP. Please try again.";
            }
        }
        catch (Exception ex)
        {
            message = "Error verifying OTP: " + ex.Message;
        }
    }

    void GoToRegister()
    {
        showRegisterPopup = false;
        Navigation.NavigateTo("/admin-register");
    }

    void ClosePopup()
    {
        showRegisterPopup = false;
    }
}
