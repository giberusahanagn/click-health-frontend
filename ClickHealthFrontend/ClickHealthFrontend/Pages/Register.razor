@page "/register"
@layout LoginLayout
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<!-- Container -->
<div class="flex justify-center items-center min-h-screen bg-gray-100 px-4">
    <div class="login-box bg-white p-6 rounded-lg shadow-xl w-full max-w-md">
        <h2 class="text-2xl font-bold text-center mb-4 text-gray-800">Create Your Account</h2>
        <p class="text-center text-gray-500 text-sm mb-6">
            Join ClickHealth to get started.
        </p>

        @if (!showApprovalPopup && !showEmailExistsPopup)
        {
            <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-red-500 mb-4" />

                <!-- Two-column grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Full Name -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                        <InputText @bind-Value="registerModel.Name" class="input-field" />
                    </div>

                    <!-- Email -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                        <InputText @bind-Value="registerModel.Email" type="email" class="input-field" />
                    </div>

                    <!-- Phone -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                        <InputText @bind-Value="registerModel.Phone" type="tel" class="input-field" />
                    </div>

                    <!-- Role -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
                        <InputSelect @bind-Value="registerModel.Role" class="input-field">
                            <option value="">-- Select Role --</option>
                            <option value="Marketing_Team">Marketing Team</option>
                            <option value="Medical_Team">Medical Team</option>
                            <option value="HCP">Healthcare Professional</option>
                            <option value="Patient">Patient</option>
                            <option value="Sales_Manager">Sales Manager</option>
                            <option value="Medical_Representative">Medical Representative</option>
                            <option value="Admin">Admin</option>
                        </InputSelect>
                    </div>

                    <!-- Territory -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Territory</label>
                        <InputSelect @bind-Value="registerModel.Territory" class="input-field">
                            <option value="">-- Select Territory --</option>
                            <option value="North">North</option>
                            <option value="South">South</option>
                            <option value="East">East</option>
                            <option value="West">West</option>
                        </InputSelect>
                    </div>

                    <!-- Preferred Language -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Preferred Language</label>
                        <InputSelect @bind-Value="registerModel.PreferredLanguage" class="input-field">
                            <option value="">-- Select Language --</option>
                            <option value="English">English</option>
                            <option value="Hindi">Hindi</option>
                            <option value="Marathi">Marathi</option>
                        </InputSelect>
                    </div>

                    <!-- HCP Specialty (full width if Role = HCP) -->
                    @if (registerModel.Role == "HCP")
                    {
                        <div class="col-span-2 mt-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Specialty</label>
                            <InputText @bind-Value="registerModel.Specialty" class="input-field" />
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p class="text-red-600 mt-4 text-center">@errorMessage</p>
                }

                <button type="submit" class="btn-primary w-full mt-6">Register</button>
            </EditForm>
        }

        <!-- Success Popup -->
        @if (showApprovalPopup)
        {
            <div class="popup-overlay">
                <div class="popup">
                    <h3 class="text-lg font-semibold text-green-600 mb-2">Registration Successful</h3>
                    <p class="text-gray-700 mb-2">Your registration has been submitted for admin approval.</p>
                    <p class="text-gray-500 text-sm mb-4">You’ll receive an email once approved.</p>
                    <button @onclick="GoToLogin" class="btn-primary w-full">Go to Login</button>
                </div>
            </div>
        }

        <!-- Email Exists Popup -->
        @if (showEmailExistsPopup)
        {
            <div class="popup-overlay">
                <div class="popup">
                    <h3 class="text-lg font-semibold text-red-600 mb-2">Email Already Exists</h3>
                    <p class="text-gray-700 text-sm mb-4">
                        The email you entered is already registered. Please use a different email or login.
                    </p>
                    <button @onclick="CloseEmailExistsPopup" class="btn-secondary w-full">Close</button>
                </div>
            </div>
        }

        <p class="text-center mt-6 text-gray-600 text-sm">
            Already have an account? <a href="/login" class="text-blue-600 hover:underline font-medium">Login here</a>
        </p>
    </div>
</div>

@code {
    private RegisterModel registerModel = new();
    private bool showApprovalPopup = false;
    private bool showEmailExistsPopup = false;
    private string errorMessage = "";

    private async Task HandleRegister()
    {
        errorMessage = "";

        registerModel.Name = registerModel.Name?.Trim();
        registerModel.Email = registerModel.Email?.Trim();
        registerModel.Phone = registerModel.Phone?.Trim();
        registerModel.Specialty = registerModel.Specialty?.Trim();

        if (string.IsNullOrWhiteSpace(registerModel.Name) ||
            string.IsNullOrWhiteSpace(registerModel.Email) ||
            string.IsNullOrWhiteSpace(registerModel.Phone) ||
            string.IsNullOrWhiteSpace(registerModel.Role) ||
            string.IsNullOrWhiteSpace(registerModel.Territory) ||
            string.IsNullOrWhiteSpace(registerModel.PreferredLanguage))
        {
            errorMessage = "Please fill all required fields.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("https://localhost:7286/api/user/register", registerModel);

            if (response.IsSuccessStatusCode)
            {
                showApprovalPopup = true;
            }
            else
            {
                var backendMessage = await response.Content.ReadAsStringAsync();
                if (backendMessage.Contains("Email already exists", StringComparison.OrdinalIgnoreCase))
                {
                    showEmailExistsPopup = true;
                }
                else
                {
                    errorMessage = $"Registration failed: {backendMessage}";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private void GoToLogin() => Navigation.NavigateTo("/login");
    private void CloseEmailExistsPopup() => showEmailExistsPopup = false;

    public class RegisterModel
    {
        [Required(ErrorMessage = "Name is required")]
        public string Name { get; set; } = string.Empty;

        [Required, EmailAddress(ErrorMessage = "Valid email is required")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Phone is required")]
        [Phone(ErrorMessage = "Valid phone number required")]
        public string Phone { get; set; } = string.Empty;

        [Required(ErrorMessage = "Role is required")]
        public string Role { get; set; } = string.Empty;

        [Required(ErrorMessage = "Territory is required")]
        public string Territory { get; set; } = string.Empty;

        [Required(ErrorMessage = "Preferred Language is required")]
        public string PreferredLanguage { get; set; } = string.Empty;

        public string Specialty { get; set; } = string.Empty;
    }
}

<style>
    /* Inputs */
    .input-field {
        background-color: white;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        padding: 0.6rem 1rem;
        width: 100%;
        outline: none;
        transition: all 0.2s;
    }

        .input-field:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

    /* Buttons */
    .btn-primary {
        background-color: #7c3aed;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        transition: background-color 0.2s, box-shadow 0.2s;
    }

        .btn-primary:hover {
            background-color: #6d28d9;
            box-shadow: 0 4px 10px rgba(124, 58, 237, 0.3);
        }

    .btn-secondary {
        background-color: #e5e7eb;
        color: #4b5563;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        font-weight: 600;
        transition: background-color 0.2s;
    }

        .btn-secondary:hover {
            background-color: #d1d5db;
        }

    /* Popups */
    .popup-overlay {
        position: fixed;
        inset: 0;
        background-color: rgba(0,0,0,0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 50;
    }

    .popup {
        background-color: white;
        padding: 2rem;
        border-radius: 1rem;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        text-align: center;
        max-width: 20rem;
        width: 100%;
    }
</style>
