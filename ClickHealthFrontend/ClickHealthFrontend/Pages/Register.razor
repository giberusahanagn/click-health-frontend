@page "/register"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@layout LoginLayout
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="register-container flex justify-center items-center min-h-screen bg-blue-600">
    <div class="register-box bg-white p-10 rounded-2xl shadow-2xl w-full max-w-5xl">
        <h2 class="text-3xl font-bold text-center text-blue-700 mb-6">Create Your Account</h2>

        @if (!showApprovalPopup && !showEmailExistsPopup)
        {
            <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <!-- Two-column grid layout -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Full Name -->
                    <div class="form-group">
                        <label class="font-semibold text-gray-700">Full Name</label>
                        <InputText @bind-Value="registerModel.Name" class="form-control w-full p-3 border border-gray-300 rounded-lg" />
                    </div>

                    <!-- Email -->
                    <div class="form-group">
                        <label class="font-semibold text-gray-700">Email</label>
                        <InputText @bind-Value="registerModel.Email" type="email" class="form-control w-full p-3 border border-gray-300 rounded-lg" />
                    </div>

                    <!-- Phone -->
                    <div class="form-group">
                        <label class="font-semibold text-gray-700">Phone Number</label>
                        <InputText @bind-Value="registerModel.Phone" type="tel" class="form-control w-full p-3 border border-gray-300 rounded-lg" />
                    </div>

                    <!-- Role -->
                    <div class="form-group">
                        <label class="font-semibold text-gray-700">Role</label>
                        <InputSelect @bind-Value="registerModel.Role" class="form-control w-full p-3 border border-gray-300 rounded-lg">
                            <option value="">-- Select Role --</option>
                            <option value="Marketing_Team">Marketing Team</option>
                            <option value="Medical_Team">Medical Team</option>
                            <option value="HCP">Healthcare Professional</option>
                            <option value="Patient">Patient</option>
                            <option value="Sales_Manager">Sales Manager</option>
                            <option value="Medical_Representative">Medical Representative</option>
                            <option value="Admin">Admin</option>
                        </InputSelect>
                    </div>

                    <!-- Territory -->
                    <div class="form-group">
                        <label class="font-semibold text-gray-700">Territory</label>
                        <InputSelect @bind-Value="registerModel.Territory" class="form-control w-full p-3 border border-gray-300 rounded-lg">
                            <option value="">-- Select Territory --</option>
                            <option value="North">North</option>
                            <option value="South">South</option>
                            <option value="East">East</option>
                            <option value="West">West</option>
                        </InputSelect>
                    </div>

                    <!-- Preferred Language -->
                    <div class="form-group">
                        <label class="font-semibold text-gray-700">Preferred Language</label>
                        <InputSelect @bind-Value="registerModel.PreferredLanguage" class="form-control w-full p-3 border border-gray-300 rounded-lg">
                            <option value="">-- Select Language --</option>
                            <option value="English">English</option>
                            <option value="Hindi">Hindi</option>
                            <option value="Marathi">Marathi</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="mt-8 text-center">
                    <button type="submit" class="bg-blue-700 hover:bg-blue-800 text-white font-semibold py-3 px-8 rounded-lg w-full md:w-1/2 shadow-md transition-all">
                        Register
                    </button>
                </div>
            </EditForm>
        }

        <!-- Approval popup -->
        @if (showApprovalPopup)
        {
            <div class="popup-overlay fixed inset-0 flex justify-center items-center bg-black bg-opacity-50">
                <div class="popup bg-white p-6 rounded-lg text-center shadow-lg max-w-md">
                    <h3 class="text-xl font-semibold mb-2 text-blue-700">Registration Successful</h3>
                    <p class="mb-2">Your registration has been submitted. Please wait for admin approval.</p>
                    <p class="mb-4">You will receive an email with login credentials once approved.</p>
                    <button @onclick="GoToLogin" class="bg-blue-700 hover:bg-blue-800 text-white py-2 px-6 rounded-lg">Go to Login</button>
                </div>
            </div>
        }

        <!-- Email exists popup -->
        @if (showEmailExistsPopup)
        {
            <div class="popup-overlay fixed inset-0 flex justify-center items-center bg-black bg-opacity-50">
                <div class="popup bg-white p-6 rounded-lg text-center shadow-lg max-w-md">
                    <h3 class="text-xl font-semibold mb-2 text-red-600">Email Already Exists</h3>
                    <p class="mb-4">The email you entered is already registered. Please use a different email or login.</p>
                    <button @onclick="CloseEmailExistsPopup" class="bg-gray-500 hover:bg-gray-600 text-white py-2 px-6 rounded-lg">Close</button>
                </div>
            </div>
        }

        <p class="text-center mt-6 text-white">
            Already have an account? <a href="/login" class="font-semibold underline hover:text-gray-200">Login here</a>
        </p>
    </div>
</div>

@code {
    private RegisterModel registerModel = new();
    private bool showApprovalPopup = false;
    private bool showEmailExistsPopup = false;
    private string errorMessage = "";

    private async Task HandleRegister()
    {
        errorMessage = "";

        registerModel.Name = registerModel.Name?.Trim();
        registerModel.Email = registerModel.Email?.Trim();
        registerModel.Phone = registerModel.Phone?.Trim();
        registerModel.Specialty = registerModel.Specialty?.Trim();

        // Basic validation
        if (string.IsNullOrWhiteSpace(registerModel.Name) ||
            string.IsNullOrWhiteSpace(registerModel.Email) ||
            string.IsNullOrWhiteSpace(registerModel.Phone) ||
            string.IsNullOrWhiteSpace(registerModel.Role) ||
            string.IsNullOrWhiteSpace(registerModel.Territory) ||
            string.IsNullOrWhiteSpace(registerModel.PreferredLanguage))
        {
            errorMessage = "Please fill all required fields.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("https://localhost:7286/api/user/register", registerModel);

            if (response.IsSuccessStatusCode)
            {
                showApprovalPopup = true;
            }
            else
            {
                var backendMessage = await response.Content.ReadAsStringAsync();

                if (backendMessage.Contains("Email already exists", StringComparison.OrdinalIgnoreCase))
                {
                    showEmailExistsPopup = true;
                }
                else
                {
                    errorMessage = $"Registration failed: {backendMessage}";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private void GoToLogin() => Navigation.NavigateTo("/login");
    private void CloseEmailExistsPopup() => showEmailExistsPopup = false;

    public class RegisterModel
    {
        [Required(ErrorMessage = "Name is required")]
        public string Name { get; set; } = string.Empty;

        [Required, EmailAddress(ErrorMessage = "Valid email is required")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Phone is required")]
        [Phone(ErrorMessage = "Valid phone number required")]
        public string Phone { get; set; } = string.Empty;

        [Required(ErrorMessage = "Role is required")]
        public string Role { get; set; } = string.Empty;

        [Required(ErrorMessage = "Territory is required")]
        public string Territory { get; set; } = string.Empty;

        [Required(ErrorMessage = "Preferred Language is required")]
        public string PreferredLanguage { get; set; } = string.Empty;

        public string Specialty { get; set; } = string.Empty;
    }
}
