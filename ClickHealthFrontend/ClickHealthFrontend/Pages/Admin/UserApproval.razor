@page "/admin/approvals"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject IJSRuntime JS

<div class="p-6 bg-gray-100 min-h-screen">
    <h3 class="text-3xl font-bold mb-6 text-gray-800">Pending User Approvals</h3>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="mb-4 p-3 rounded text-white" style="background-color:@statusColor">
            @statusMessage
        </div>
    }

    @if (pendingUsers == null)
    {
        <p class="text-gray-500">Loading...</p>
    }
    else if (!pendingUsers.Any())
    {
        <p class="text-gray-500">No pending users.</p>
    }
    else
    {
        <div class="overflow-x-auto bg-white shadow-lg rounded-lg">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Phone</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Specialty</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Territory</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Preferred Language</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var user in pendingUsers)
                    {
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4 whitespace-nowrap text-gray-700">@user.Email</td>
                            <td class="px-6 py-4 whitespace-nowrap text-gray-700">@user.Name</td>
                            <td class="px-6 py-4 whitespace-nowrap text-gray-700 font-medium">
                                <select @bind="user.Role" class="border rounded px-2 py-1 text-sm">
                                    @foreach (var role in roles)
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </select>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-gray-700">@user.Phone</td>
                            <td class="px-6 py-4 whitespace-nowrap text-gray-700">@user.Specialty</td>
                            <td class="px-6 py-4 whitespace-nowrap text-gray-700">@user.Territory</td>
                            <td class="px-6 py-4 whitespace-nowrap text-gray-700">@user.PreferredLanguage</td>
                            <td class="px-6 py-4 whitespace-nowrap space-x-2">
                                <button class="bg-green-600 text-white px-3 py-1 rounded-md hover:bg-green-700 transition"
                                        @onclick="() => ApproveUser(user)">
                                    Approve
                                </button>
                                <button class="bg-red-600 text-white px-3 py-1 rounded-md hover:bg-red-700 transition"
                                        @onclick="() => RejectUser(user.Email)">
                                    Reject
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<UserDto>? pendingUsers;
    private string statusMessage = "";
    private string statusColor = "green";

    // Define roles locally
    private List<string> roles = new() { "Marketing_Team", "Sales_Team", "Support_Team" };

    protected override async Task OnInitializedAsync()
    {
        pendingUsers = await Http.GetFromJsonAsync<List<UserDto>>("https://localhost:7286/api/admin/pending-users");
    }

    private async Task ApproveUser(UserDto user)
    {
        try
        {
            var response = await Http.PostAsJsonAsync($"https://localhost:7286/api/admin/approve-user/{user.Email}", new { role = user.Role });
            if (response.IsSuccessStatusCode)
            {
                pendingUsers = pendingUsers?.Where(u => u.Email != user.Email).ToList();
                statusMessage = $"User {user.Email} approved and email sent!";
                statusColor = "green";
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                statusMessage = $"Failed to approve: {msg}";
                statusColor = "red";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            statusColor = "red";
        }
    }

    private async Task RejectUser(string email)
    {
        try
        {
            var response = await Http.PostAsJsonAsync($"https://localhost:7286/api/admin/reject-user/{email}", new { reason = "Rejected by admin" });
            if (response.IsSuccessStatusCode)
            {
                pendingUsers = pendingUsers?.Where(u => u.Email != email).ToList();
                statusMessage = $"User {email} rejected and email sent!";
                statusColor = "red";
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                statusMessage = $"Failed to reject: {msg}";
                statusColor = "red";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            statusColor = "red";
        }
    }

    public class UserDto
    {
        public string Email { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Specialty { get; set; } = string.Empty;
        public string Territory { get; set; } = string.Empty;
        public string PreferredLanguage { get; set; } = string.Empty;
    }
}
