@page "/admin/approvals"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http

<div class="p-8 bg-gray-100 min-h-screen">
    <h2 class="text-4xl font-bold mb-8 text-gray-800">Pending User Approvals</h2>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="mb-6 p-4 rounded-lg text-white font-medium transition-all duration-300"
             style="background-color:@statusColor">
            @statusMessage
        </div>
    }

    @if (pendingUsers == null)
    {
        <div class="text-gray-500 text-lg">Loading pending users...</div>
    }
    else if (!pendingUsers.Any())
    {
        <div class="text-gray-500 text-lg">No pending users at the moment ✅</div>
    }
    else
    {
        <div class="overflow-x-auto shadow-lg rounded-2xl bg-white">
            <table class="min-w-full text-sm text-left text-gray-700">
                <thead class="bg-gray-50 text-xs uppercase text-gray-500 border-b">
                    <tr>
                        <th class="px-6 py-3">Name</th>
                        <th class="px-6 py-3">Email</th>
                        <th class="px-6 py-3">Role</th>
                        <th class="px-6 py-3">Phone</th>
                        <th class="px-6 py-3">Specialty</th>
                        <th class="px-6 py-3">Territory</th>
                        <th class="px-6 py-3">Preferred Language</th>
                        <th class="px-6 py-3 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in pendingUsers)
                    {
                        <tr class="hover:bg-gray-50 border-b transition-all">
                            <td class="px-6 py-4 font-medium text-gray-800">@user.Name</td>
                            <td class="px-6 py-4">@user.Email</td>
                            <td class="px-6 py-4">
                                <select @bind="user.Role"
                                        class="border border-gray-300 rounded-lg px-3 py-1 text-sm focus:ring-2 focus:ring-blue-400 focus:outline-none">
                                    @foreach (var role in roles)
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </select>
                            </td>
                            <td class="px-6 py-4">@user.Phone</td>
                            <td class="px-6 py-4">@user.Specialty</td>
                            <td class="px-6 py-4">@user.Territory</td>
                            <td class="px-6 py-4">@user.PreferredLanguage</td>
                            <td class="px-6 py-4 text-center space-x-3">
                                <button class="bg-green-600 text-white px-4 py-1 rounded-lg hover:bg-green-700 transition"
                                        @onclick="() => ApproveUser(user)">
                                    Approve
                                </button>
                                <button class="bg-red-600 text-white px-4 py-1 rounded-lg hover:bg-red-700 transition"
                                        @onclick="() => RejectUser(user.Email)">
                                    Reject
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<UserDto>? pendingUsers;
    private List<string> roles = new();
    private string statusMessage = string.Empty;
    private string statusColor = "green";

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
        await LoadPendingUsersAsync();
    }

    private async Task LoadPendingUsersAsync()
    {
        try
        {
            pendingUsers = await Http.GetFromJsonAsync<List<UserDto>>("https://localhost:7286/api/admin/pending-users");
        }
        catch (Exception ex)
        {
            statusMessage = $"Error loading pending users: {ex.Message}";
            statusColor = "#dc2626";
        }
    }

    private async Task LoadRolesAsync()
    {
        try
        {
            roles = await Http.GetFromJsonAsync<List<string>>("https://localhost:7286/api/admin/roles") ?? new();
        }
        catch (Exception ex)
        {
            statusMessage = $"Error loading roles: {ex.Message}";
            statusColor = "#dc2626";
        }
    }

    private async Task ApproveUser(UserDto user)
    {
        try
        {
            var response = await Http.PostAsJsonAsync($"https://localhost:7286/api/admin/approve-user/{user.Email}", user.Role);
            if (response.IsSuccessStatusCode)
            {
                pendingUsers?.RemoveAll(u => u.Email == user.Email);
                statusMessage = $"✅ User {user.Email} approved successfully. Email sent!";
                statusColor = "#16a34a";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                statusMessage = $"❌ Failed to approve user: {error}";
                statusColor = "#dc2626";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"⚠️ Error approving user: {ex.Message}";
            statusColor = "#dc2626";
        }
    }

    private async Task RejectUser(string email)
    {
        try
        {
            var response = await Http.PostAsJsonAsync($"https://localhost:7286/api/admin/reject-user/{email}", "Rejected by admin");
            if (response.IsSuccessStatusCode)
            {
                pendingUsers?.RemoveAll(u => u.Email == email);
                statusMessage = $"🚫 User {email} rejected and notified by email.";
                statusColor = "#dc2626";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                statusMessage = $"❌ Failed to reject user: {error}";
                statusColor = "#dc2626";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"⚠️ Error rejecting user: {ex.Message}";
            statusColor = "#dc2626";
        }
    }

    public class UserDto
    {
        public string Email { get; set; } = "";
        public string Name { get; set; } = "";
        public string Role { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Specialty { get; set; } = "";
        public string Territory { get; set; } = "";
        public string PreferredLanguage { get; set; } = "";
    }
}
