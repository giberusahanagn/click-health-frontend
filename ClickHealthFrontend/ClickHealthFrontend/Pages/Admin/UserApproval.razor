@page "/admin/approvals"
@using System.Net.Http.Json
@inject HttpClient Http

<h3 class="text-3xl font-bold mb-6 text-gray-800">Pending User Approvals</h3>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="p-3 mb-4 rounded text-white" style="background-color:@StatusColor">
        @StatusMessage
    </div>
}

@if (PendingUsers == null)
{
    <p class="text-gray-500">Loading...</p>
}
else if (!PendingUsers.Any())
{
    <p class="text-gray-500">No pending users.</p>
}
else
{
    <div class="overflow-x-auto bg-white shadow-md rounded-lg">
        <table class="min-w-full table-auto border-collapse border border-gray-200">
            <thead class="bg-gray-100">
                <tr>
                    <th class="border px-4 py-2">Email</th>
                    <th class="border px-4 py-2">Name</th>
                    <th class="border px-4 py-2">Role</th>
                    <th class="border px-4 py-2">Phone</th>
                    <th class="border px-4 py-2">Specialty</th>
                    <th class="border px-4 py-2">Territory</th>
                    <th class="border px-4 py-2">Language</th>
                    <th class="border px-4 py-2">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in PendingUsers)
                {
                    <tr class="hover:bg-gray-50 transition">
                        <td class="border px-4 py-2">@user.Email</td>
                        <td class="border px-4 py-2">@user.Name</td>
                        <td class="border px-4 py-2">
                            <select @bind="user.Role" class="border rounded px-2 py-1 w-full">
                                @foreach (var r in Roles)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                        </td>
                        <td class="border px-4 py-2">@user.Phone</td>
                        <td class="border px-4 py-2">@user.Specialty</td>
                        <td class="border px-4 py-2">@user.Territory</td>
                        <td class="border px-4 py-2">@user.PreferredLanguage</td>
                        <td class="border px-4 py-2 space-x-2">
                            <button class="bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700 transition"
                                    @onclick="() => ApproveUser(user)">
                                Approve
                            </button>
                            <button class="bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700 transition"
                                    @onclick="() => RejectUser(user.Email)">
                                Reject
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    // List of pending users
    private List<UserDto>? PendingUsers;

    // Status messages
    private string StatusMessage = "";
    private string StatusColor = "green";

    // Roles enum as string list
    private List<string> Roles = Enum.GetNames(typeof(UserRole)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingUsers();
    }

    private async Task LoadPendingUsers()
    {
        PendingUsers = await Http.GetFromJsonAsync<List<UserDto>>("https://localhost:7286/api/admin/pending-users");
    }

    private async Task ApproveUser(UserDto user)
    {
        var dto = new RoleRequestDto { Role = user.Role };
        var response = await Http.PostAsJsonAsync($"https://localhost:7286/api/admin/approve-user/{user.Email}", dto);

        if (response.IsSuccessStatusCode)
        {
            PendingUsers = PendingUsers?.Where(u => u.Email != user.Email).ToList();
            StatusMessage = $"User {user.Email} approved!";
            StatusColor = "green";
        }
        else
        {
            StatusMessage = $"Failed to approve user.";
            StatusColor = "red";
        }
    }

    private async Task RejectUser(string email)
    {
        var dto = new RejectRequestDto { Reason = "Rejected by admin" };
        var response = await Http.PostAsJsonAsync($"https://localhost:7286/api/admin/reject-user/{email}", dto);

        if (response.IsSuccessStatusCode)
        {
            PendingUsers = PendingUsers?.Where(u => u.Email != email).ToList();
            StatusMessage = $"User {email} rejected!";
            StatusColor = "red";
        }
        else
        {
            StatusMessage = $"Failed to reject user.";
            StatusColor = "red";
        }
    }

    // DTOs inside razor page
    public class UserDto
    {
        public string Email { get; set; } = "";
        public string Name { get; set; } = "";
        public string Role { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Specialty { get; set; } = "";
        public string Territory { get; set; } = "";
        public string PreferredLanguage { get; set; } = "";
    }

    public class RoleRequestDto { public string Role { get; set; } = ""; }
    public class RejectRequestDto { public string Reason { get; set; } = ""; }

    // Local enum duplicate for frontend
    public enum UserRole
    {
        Marketing_Team,
        Medical_Team,
        HCP,
        Patient,
        Sales_Manager,
        Medical_Representative,
        Admin
    }
}
