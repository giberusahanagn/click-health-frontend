                    <td class="px-4 py-2">@(!string.IsNullOrEmpty(item.Description) ? item.Description : "N/A")</td>
                    <td class="px-4 py-2">
                        @if (!string.IsNullOrEmpty(item.PdfUrl))
                        {
                            <a href="@item.PdfUrl" target="_blank" class="text-blue-600 hover:underline">View PDF</a>
                        }
                        else
