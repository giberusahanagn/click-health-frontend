        <tbody>
            @foreach (var item in RejectedContents)
            {
                <tr class="border-b hover:bg-gray-50">
                    <td class="px-4 py-2">@(!string.IsNullOrEmpty(item.Title) ? item.Title : "N/A")</td>
                    <td class="px-4 py-2">@(!string.IsNullOrEmpty(item.Language) ? item.Language : "N/A")</td>
