                    <td class="px-4 py-2">@item.EndDate?.ToString("yyyy-MM-dd") ?? "N/A"</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public List<ContentDto> Items { get; set; } = new();
    [Parameter] public EventCallback<string> OnApprove { get; set; }
    [Parameter] public EventCallback<string> OnReject { get; set; }

    private List<ContentDto> PendingContents => Items.Where(i => i.Status == "Pending").ToList();
    private List<ContentDto> ApprovedContents => Items.Where(i => i.Status == "Approved").ToList();
    private List<ContentDto> RejectedContents => Items.Where(i => i.Status == "Rejected").ToList();

    public class ContentDto
    {
        public string ContentId { get; set; } = "";
        public string Title { get; set; } = "";
        public string Language { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime? EndDate { get; set; }
        public string PdfUrl { get; set; } = "";
        public string VideoUrl { get; set; } = "";
        public string Status { get; set; } = "Pending"; // "Pending", "Approved", "Rejected"
    }
}
