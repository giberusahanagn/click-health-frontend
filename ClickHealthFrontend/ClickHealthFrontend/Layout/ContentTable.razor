<h1 class="text-2xl font-bold mb-4">Medical Content Dashboard</h1>

<div class="mb-6">
    <div>Approved: @ApprovedContents.Count</div>
    <div>Pending Approval: @PendingContents.Count</div>
    <div>Rejected: @RejectedContents.Count</div>
</div>

@if (PendingContents.Any())
{
    <h2 class="text-xl font-semibold mt-4">Pending Contents</h2>
    <table class="min-w-full border rounded-lg overflow-hidden shadow mb-6">
        <thead class="bg-gray-100">
            <tr>
                <th class="px-4 py-2 text-left">Medical Name</th>
                <th class="px-4 py-2 text-left">Language</th>
                <th class="px-4 py-2 text-left">Description</th>
                <th class="px-4 py-2 text-left">View PDF</th>
                <th class="px-4 py-2 text-left">View Video</th>
                <th class="px-4 py-2 text-left">End Date</th>
                <th class="px-4 py-2 text-left">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in PendingContents)
            {
                <tr class="border-b hover:bg-gray-50">
                    <td class="px-4 py-2">@(!string.IsNullOrEmpty(item.Title) ? item.Title : "N/A")</td>
                    <td class="px-4 py-2">@(!string.IsNullOrEmpty(item.Language) ? item.Language : "N/A")</td>
                    <td class="px-4 py-2">@(!string.IsNullOrEmpty(item.Description) ? item.Description : "N/A")</td>
                    <td class="px-4 py-2">
                        @if (!string.IsNullOrEmpty(item.PdfUrl))
                        {
                            <a href="@item.PdfUrl" target="_blank" class="text-blue-600 hover:underline">View PDF</a>
                        }
                        else
                        {
                            <span class="text-gray-400">N/A</span>
                        }
                    </td>
                    <td class="px-4 py-2">
                        @if (!string.IsNullOrEmpty(item.VideoUrl))
                        {
                            <a href="@item.VideoUrl" target="_blank" class="text-blue-600 hover:underline">View Video</a>
                        }
                        else
                        {
                            <span class="text-gray-400">N/A</span>
                        }
                    </td>
                    <td class="px-4 py-2">@item.EndDate?.ToString("yyyy-MM-dd") ?? "N/A"</td>
                    <td class="px-4 py-2 space-x-2">
                        <button class="bg-green-500 text-white px-2 py-1 rounded" @onclick="@(() => OnApprove.InvokeAsync(item.ContentId))">Approve</button>
                        <button class="bg-red-500 text-white px-2 py-1 rounded" @onclick="@(() => OnReject.InvokeAsync(item.ContentId))">Reject</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

