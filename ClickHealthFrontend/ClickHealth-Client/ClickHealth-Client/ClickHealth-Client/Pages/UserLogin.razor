@page "/user-login"
@inject HttpClient Http
@inject NavigationManager Nav

<h3 class="text-center mb-3">User Login</h3>

<div class="card p-4 shadow-lg rounded mx-auto" style="max-width:400px">
    <input @bind="email" placeholder="Email" class="form-control mb-2" />
    <input @bind="password" type="password" placeholder="Password" class="form-control mb-3" />

    <button class="btn btn-primary w-100 mb-2" @onclick="LoginUser">Get OTP</button>

    @if (otpRequested)
    {
        <input @bind="otp" placeholder="Enter OTP" class="form-control mb-2" />
        <button class="btn btn-success w-100" @onclick="VerifyOtp">Verify OTP</button>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <p class="text-info text-center mt-2">@message</p>
    }
</div>

<!-- Modal for unregistered users -->
@if (showRegisterPopup)
{
    <div class="modal show fade d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">User Not Registered</h5>
                    <button class="btn-close" @onclick="ClosePopup"></button>
                </div>
                <div class="modal-body text-center">
                    <p>You are not registered or not approved yet. Please register first.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button class="btn btn-secondary" @onclick="ClosePopup">Cancel</button>
                    <button class="btn btn-primary" @onclick="GoToRegister">Register</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    string email = "";
    string password = "";
    string otp = "";
    bool otpRequested = false;
    string message = "";
    bool showRegisterPopup = false;

    private async Task LoginUser()
    {
        var payload = new { Email = email, Password = password };
        var response = await Http.PostAsJsonAsync("api/user/login", payload);

        if (response.IsSuccessStatusCode)
        {
            otpRequested = true;
            message = "OTP sent to your email!";
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            showRegisterPopup = true;
        }
        else
        {
            message = "Login failed!";
        }
    }

    private async Task VerifyOtp()
    {
        var payload = new { Email = email, Otp = otp };
        var response = await Http.PostAsJsonAsync("api/user/verify-otp", payload);

        if (response.IsSuccessStatusCode)
        {
            message = "Login successful!";
        }
        else
        {
            message = "Invalid or expired OTP.";
        }
    }

    void ClosePopup() => showRegisterPopup = false;

    void GoToRegister()
    {
        showRegisterPopup = false;
        Nav.NavigateTo("/register");
    }
}
